# Firebase web config (public by design; Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# The referral backend's URL, no trailing slash.
# For local preview against a local proxy on :8787, use /api (see vite.config.js).
VITE_REFERRAL_API_URL=
